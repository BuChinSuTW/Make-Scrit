------------------------------------------------------------------------
-- Render loop
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local cam      = workspace.CurrentCamera
    local vp       = cam.ViewportSize
    local lineFrom = Vector2.new(vp.X * 0.5, vp.Y)
    local total    = 0

    CountLabel.Position = Vector2.new(vp.X * 0.5, 28)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        total = total + 1

        local esp = ESPCache[player]
        if not esp then continue end

        local char = player.Character
        if not char then hideDrawings(player); continue end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local hrp      = char:FindFirstChild("HumanoidRootPart")
        local head     = char:FindFirstChild("Head")

        if not humanoid or not hrp or not head or humanoid.Health <= 0 then
            hideDrawings(player); continue
        end

        local headTop = head.Position + Vector3.new(0, head.Size.Y*0.5, 0)
        local feet    = hrp.Position  - Vector3.new(0, CFG.FeetOffset, 0)
        local headCtr = head.Position

        local htSP = cam:WorldToViewportPoint(headTop)
        local ftSP = cam:WorldToViewportPoint(feet)
        local hcSP = cam:WorldToViewportPoint(headCtr)

        if htSP.Z < 0 then hideDrawings(player); continue end

        local col  = getColor(player)
        local bH   = math.abs(htSP.Y - ftSP.Y)
        local bW   = bH * CFG.BoxWidthRatio
        local cx   = htSP.X
        local bTop = htSP.Y
        local bBot = ftSP.Y
        local bL   = cx - bW*0.5
        local bR   = cx + bW*0.5

        -- Box
        esp.BoxTop.From    = Vector2.new(bL, bTop); esp.BoxTop.To    = Vector2.new(bR, bTop)
        esp.BoxTop.Color   = col;                    esp.BoxTop.Visible= FLAGS.Box
        esp.BoxBot.From    = Vector2.new(bL, bBot); esp.BoxBot.To    = Vector2.new(bR, bBot)
        esp.BoxBot.Color   = col;                    esp.BoxBot.Visible= FLAGS.Box
        esp.BoxLeft.From   = Vector2.new(bL, bTop); esp.BoxLeft.To   = Vector2.new(bL, bBot)
        esp.BoxLeft.Color  = col;                    esp.BoxLeft.Visible= FLAGS.Box
        esp.BoxRight.From  = Vector2.new(bR, bTop); esp.BoxRight.To  = Vector2.new(bR, bBot)
        esp.BoxRight.Color = col;                    esp.BoxRight.Visible= FLAGS.Box

        -- Head
        esp.Head.Position = Vector2.new(hcSP.X, hcSP.Y)
        esp.Head.Color    = col; esp.Head.Visible = FLAGS.Head

        -- Tracer
        esp.Line.From    = lineFrom
        esp.Line.To      = Vector2.new(cx, bBot)
        esp.Line.Color   = col; esp.Line.Visible = FLAGS.Line

        -- Name
        esp.Name.Text     = player.Name
        esp.Name.Position = Vector2.new(cx, bTop - 16)
        esp.Name.Visible  = FLAGS.Name

        -- HP bar
        local pct = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        local hpH = bH * pct
        local barX = bL - CFG.HPBarGap

        esp.HPBg.From    = Vector2.new(barX, bTop)
        esp.HPBg.To      = Vector2.new(barX, bBot)
        esp.HPBg.Visible = FLAGS.HP

        esp.HPFill.From    = Vector2.new(barX, bBot)
        esp.HPFill.To      = Vector2.new(barX, bBot - hpH)
        esp.HPFill.Color   = hpColor(pct)
        esp.HPFill.Visible = FLAGS.HP

        esp.HPText.Text     = math.floor(pct*100).."%"
        esp.HPText.Position = Vector2.new(barX, bTop - 14)
        esp.HPText.Visible  = FLAGS.HP

        -- Highlight sync
        local hl = char:FindFirstChild("__ESPhl")
        if hl then hl.FillColor = col; hl.OutlineColor = col end
    end

    CountLabel.Text = string.format("%s : %d", "\240\159\145\164", total)
end)

