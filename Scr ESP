}

local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function getColor(player)
    if _G.UseTeamColor then return player.TeamColor.Color end
    return (LocalPlayer.TeamColor == player.TeamColor) and _G.FriendColor or _G.EnemyColor
end

local function hpColor(pct)
    if pct > 0.5 then
        return Color3.fromRGB(math.floor(255*(1-pct)*2), 255, 0)
    else
        return Color3.fromRGB(255, math.floor(255*pct*2), 0)
    end
end

local function makeLine(thick, color)
    local l = Drawing.new("Line")
    l.Visible = false; l.Thickness = thick; l.Color = color; l.ZIndex = 5
    return l
end

local function makeCircle(radius, thick, color)
    local c = Drawing.new("Circle")
    c.Visible = false; c.Filled = false; c.Thickness = thick
    c.Radius = radius; c.Color = color; c.ZIndex = 5
    return c
end

local function makeText(size, color, center)
    local t = Drawing.new("Text")
    t.Visible = false; t.Size = size; t.Color = color
    t.Outline = true; t.Center = (center ~= false); t.ZIndex = 6
    return t
end

local ESPCache  = {}
local DRAW_KEYS = {"BoxTop","BoxBot","BoxLeft","BoxRight","Head","Line","Name","HPBg","HPFill","HPText"}

local function createDrawings(player)
    if ESPCache[player] then return end
    local col = getColor(player)
    ESPCache[player] = {
        BoxTop   = makeLine(CFG.BoxThickness, col),
        BoxBot   = makeLine(CFG.BoxThickness, col),
        BoxLeft  = makeLine(CFG.BoxThickness, col),
        BoxRight = makeLine(CFG.BoxThickness, col),
        Head     = makeCircle(CFG.HeadRadius, CFG.BoxThickness, col),
        Line     = makeLine(CFG.LineThickness, col),
        Name     = makeText(CFG.NameSize, Color3.fromRGB(255,255,255), true),
        HPBg     = makeLine(CFG.HPBarWidth+2, Color3.fromRGB(0,0,0)),
        HPFill   = makeLine(CFG.HPBarWidth, Color3.fromRGB(0,255,0)),
        HPText   = makeText(CFG.HPSize, Color3.fromRGB(255,255,255), true),
    }
    ESPCache[player].Name.Text = player.Name
end

local function removeDrawings(player)
    local esp = ESPCache[player]
    if not esp then return end
    for _, key in ipairs(DRAW_KEYS) do pcall(function() esp[key]:Remove() end) end
    ESPCache[player] = nil
end

local function hideDrawings(player)
    local esp = ESPCache[player]
    if not esp then return end
    for _, key in ipairs(DRAW_KEYS) do pcall(function() esp[key].Visible = false end) end
end

local function applyHighlight(player)
    if not FLAGS.Highlight then return end
    local char = player.Character
    if not char then return end
    local old = char:FindFirstChild("__ESPhl")
    if old then old:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = "__ESPhl"; hl.Adornee = char
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = getColor(player); hl.FillTransparency = 0.5
    hl.OutlineColor = getColor(player); hl.OutlineTransparency = 0
    hl.Parent = char
end

local function removeHighlight(player)
    local char = player.Character
    if not char then return end
    local hl = char:FindFirstChild("__ESPhl")
    if hl then hl:Destroy() end
end

local function onCharAdded(player, char)
    char:WaitForChild("Humanoid", 8)
    char:WaitForChild("HumanoidRootPart", 8)
    char:WaitForChild("Head", 8)
    createDrawings(player)
    applyHighlight(player)
end

local function hookPlayer(player)
    if player == LocalPlayer then return end
    createDrawings(player)
    player.CharacterAdded:Connect(function(char) task.spawn(onCharAdded, player, char) end)
    player.CharacterRemoving:Connect(function() hideDrawings(player) end)
    player:GetPropertyChangedSignal("TeamColor"):Connect(function()
        local esp = ESPCache[player]
        if not esp then return end
        local col = getColor(player)
        for _, key in ipairs({"BoxTop","BoxBot","BoxLeft","BoxRight","Head","Line"}) do
            esp[key].Color = col
        end
        local char = player.Character
        if char then
            local hl = char:FindFirstChild("__ESPhl")
            if hl then hl.FillColor = col; hl.OutlineColor = col end
        end
    end)
    if player.Character then task.spawn(onCharAdded, player, player.Character) end
end

