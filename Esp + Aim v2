local ESPCache={}
local DRAW_KEYS={"BoxTop","BoxBot","BoxLeft","BoxRight","Head","Line","Name","HPBg","HPFill","HPText"}

local function createDrawings(p)
    if ESPCache[p] then return end
    local col=getColor(p)
    ESPCache[p]={
        BoxTop  =makeLine(CFG.BoxThickness,col), BoxBot  =makeLine(CFG.BoxThickness,col),
        BoxLeft =makeLine(CFG.BoxThickness,col), BoxRight=makeLine(CFG.BoxThickness,col),
        Head    =makeCircle(CFG.HeadRadius,CFG.BoxThickness,col),
        Line    =makeLine(CFG.LineThickness,col),
        Name    =makeText(CFG.NameSize,Color3.fromRGB(255,255,255),true),
        HPBg    =makeLine(CFG.HPBarWidth+2,Color3.fromRGB(0,0,0)),
        HPFill  =makeLine(CFG.HPBarWidth,Color3.fromRGB(0,255,0)),
        HPText  =makeText(CFG.HPSize,Color3.fromRGB(255,255,255),true),
    }
    ESPCache[p].Name.Text=p.Name
end

local function removeDrawings(p)
    local e=ESPCache[p]; if not e then return end
    for _,k in ipairs(DRAW_KEYS) do pcall(function() e[k]:Remove() end) end
    ESPCache[p]=nil
end

local function hideDrawings(p)
    local e=ESPCache[p]; if not e then return end
    for _,k in ipairs(DRAW_KEYS) do pcall(function() e[k].Visible=false end) end
end

local function applyHighlight(p)
    if not FLAGS.Highlight then return end
    local char=p.Character; if not char then return end
    local old=char:FindFirstChild("__ESPhl"); if old then old:Destroy() end
    local hl=Instance.new("Highlight")
    hl.Name="__ESPhl"; hl.Adornee=char
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor=getColor(p); hl.FillTransparency=0.5
    hl.OutlineColor=getColor(p); hl.OutlineTransparency=0; hl.Parent=char
end

local function removeHighlight(p)
    local char=p.Character; if not char then return end
    local hl=char:FindFirstChild("__ESPhl"); if hl then hl:Destroy() end
end

local function onCharAdded(p,char)
    char:WaitForChild("Humanoid",8)
    char:WaitForChild("HumanoidRootPart",8)
    char:WaitForChild("Head",8)
    createDrawings(p); applyHighlight(p)
end

local function hookPlayer(p)
    if p==LocalPlayer then return end
    createDrawings(p)
    p.CharacterAdded:Connect(function(char) task.spawn(onCharAdded,p,char) end)
    p.CharacterRemoving:Connect(function() hideDrawings(p) end)
    p:GetPropertyChangedSignal("TeamColor"):Connect(function()
        local e=ESPCache[p]; if not e then return end
        local col=getColor(p)
        for _,k in ipairs({"BoxTop","BoxBot","BoxLeft","BoxRight","Head","Line"}) do e[k].Color=col end
        local char=p.Character
        if char then
            local hl=char:FindFirstChild("__ESPhl")
            if hl then hl.FillColor=col; hl.OutlineColor=col end
        end
    end)
    if p.Character then task.spawn(onCharAdded,p,p.Character) end
end

local function applyNoFog(on)
    local L=game:GetService("Lighting")
    L.FogEnd=on and 1e8 or 100000; L.FogStart=on and 1e8 or 0
    local atmo=L:FindFirstChildOfClass("Atmosphere")
    if atmo then atmo.Density=on and 0 or 0.35 end
end

RunService.Heartbeat:Connect(function()
    if FLAGS.InfStamina then
        local char=LocalPlayer.Character
        if char then
            local hum=char:FindFirstChildOfClass("Humanoid")
            if hum then
                for _,n in ipairs({"Stamina","Energy","Sprint","Endurance"}) do
                    pcall(function()
                        local v=hum:FindFirstChild(n)
                        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then v.Value=v.MaxValue or 100 end
                    end)
                    pcall(function()
                        if hum:GetAttribute(n)~=nil then
                            hum:SetAttribute(n,hum:GetAttribute("Max"..n) or 100)
                        end
                    end)
                end
            end
        end
    end
    if FLAGS.InfAmmo then
        local char=LocalPlayer.Character
        if char then
            for _,tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    for _,v in ipairs(tool:GetDescendants()) do
                        if v:IsA("NumberValue") or v:IsA("IntValue") then
                            local n=v.Name:lower()
                            if n:find("ammo") or n:find("bullet") or n:find("clip")
                            or n:find("mag") or n:find("shot") then v.Value=9999 end
                        end
                        pcall(function()
                            for _,a in ipairs({"Ammo","Bullets","Clip","Magazine","Shots"}) do
                                if v:GetAttribute(a)~=nil then v:SetAttribute(a,9999) end
                            end
                        end)
                    end
                end
            end
        end
    end
end)

