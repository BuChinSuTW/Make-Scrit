RunService.RenderStepped:Connect(function()
    local cam=Camera; local vp=cam.ViewportSize
    local lineFrom=Vector2.new(vp.X*.5,vp.Y)
    local center=Vector2.new(vp.X*.5,vp.Y*.5)
    local total=0

    FOVCircle.Position=center; FOVCircle.Visible=FLAGS.Aimbot

    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        total=total+1
        local e=ESPCache[p]; if not e then continue end
        local char=p.Character
        if not char then hideDrawings(p); continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        local hrp=char:FindFirstChild("HumanoidRootPart")
        local head=char:FindFirstChild("Head")
        if not hum or not hrp or not head or hum.Health<=0 then hideDrawings(p); continue end
        local headTop=head.Position+Vector3.new(0,head.Size.Y*.5,0)
        local feet=hrp.Position-Vector3.new(0,CFG.FeetOffset,0)
        local headCtr=head.Position
        local htSP=cam:WorldToViewportPoint(headTop)
        local ftSP=cam:WorldToViewportPoint(feet)
        local hcSP=cam:WorldToViewportPoint(headCtr)
        if htSP.Z<0 then hideDrawings(p); continue end
        local col=getColor(p)
        local bH=math.abs(htSP.Y-ftSP.Y); local bW=bH*CFG.BoxWidthRatio
        local cx=htSP.X; local bTop=htSP.Y; local bBot=ftSP.Y
        local bL=cx-bW*.5; local bR=cx+bW*.5
        e.BoxTop.From=Vector2.new(bL,bTop);  e.BoxTop.To=Vector2.new(bR,bTop)
        e.BoxTop.Color=col;  e.BoxTop.Visible=FLAGS.Box
        e.BoxBot.From=Vector2.new(bL,bBot);  e.BoxBot.To=Vector2.new(bR,bBot)
        e.BoxBot.Color=col;  e.BoxBot.Visible=FLAGS.Box
        e.BoxLeft.From=Vector2.new(bL,bTop); e.BoxLeft.To=Vector2.new(bL,bBot)
        e.BoxLeft.Color=col; e.BoxLeft.Visible=FLAGS.Box
        e.BoxRight.From=Vector2.new(bR,bTop);e.BoxRight.To=Vector2.new(bR,bBot)
        e.BoxRight.Color=col;e.BoxRight.Visible=FLAGS.Box
        e.Head.Position=Vector2.new(hcSP.X,hcSP.Y)
        e.Head.Color=col; e.Head.Visible=FLAGS.Head
        e.Line.From=lineFrom; e.Line.To=Vector2.new(cx,bBot)
        e.Line.Color=col; e.Line.Visible=FLAGS.Line
        e.Name.Text=p.Name; e.Name.Position=Vector2.new(cx,bTop-16)
        e.Name.Visible=FLAGS.Name
        local pct=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
        local hpH=bH*pct; local barX=bL-CFG.HPBarGap
        e.HPBg.From=Vector2.new(barX,bTop); e.HPBg.To=Vector2.new(barX,bBot)
        e.HPBg.Visible=FLAGS.HP
        e.HPFill.From=Vector2.new(barX,bBot); e.HPFill.To=Vector2.new(barX,bBot-hpH)
        e.HPFill.Color=hpColor(pct); e.HPFill.Visible=FLAGS.HP
        e.HPText.Text=math.floor(pct*100).."%"
        e.HPText.Position=Vector2.new(barX,bTop-14); e.HPText.Visible=FLAGS.HP
        local hl=char:FindFirstChild("__ESPhl")
        if hl then hl.FillColor=col; hl.OutlineColor=col end
    end
    CountLabel.Text="Player : "..total
end)

