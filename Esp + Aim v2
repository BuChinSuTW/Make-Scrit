local function getAimTarget()
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local best, bestD = nil, AimbotFOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not isEnemy(p) then continue end
        local char = p.Character; if not char then continue end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        if not hum or not head or hum.Health <= 0 then continue end
        if not isVisible(head.Position) then continue end
        local sp, vis = Camera:WorldToViewportPoint(head.Position)
        if not vis or sp.Z < 0 then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < bestD then bestD = d; best = head end
    end
    return best
end

-- Original camera type để restore
local origCamType = Camera.CameraType

RunService.RenderStepped:Connect(function()
    if not FLAGS.Aimbot then
        -- Restore camera nếu aimbot OFF
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = origCamType
        end
        return
    end

    if not aimbotTrigger then
        -- Không aim → restore camera ke Custom (default Roblox)
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
        return
    end

    local target = getAimTarget()
    if not target then
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
        return
    end

    -- Lock camera ke Scriptable agar bisa dicontrol penuh
    if Camera.CameraType ~= Enum.CameraType.Scriptable then
        Camera.CameraType = Enum.CameraType.Scriptable
    end

    local targetPos = target.Position
    local camPos    = Camera.CFrame.Position
    local currentCF = Camera.CFrame
    local goalCF    = CFrame.lookAt(camPos, targetPos)
    local alpha     = smoothAlpha()

    Camera.CFrame = currentCF:Lerp(goalCF, alpha)
end)

-- Restore camera saat aimbot di-toggle OFF
local prevAimbot = false
RunService.Heartbeat:Connect(function()
    if prevAimbot ~= FLAGS.Aimbot then
        if not FLAGS.Aimbot then
            Camera.CameraType = Enum.CameraType.Custom
        end
        prevAimbot = FLAGS.Aimbot
    end
end)

