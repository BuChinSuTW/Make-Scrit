local AimbotFOV    = 120
local AimbotSmooth = 5   -- 1=instant, 50=creep

local function smoothAlpha()
    return math.clamp(1 / AimbotSmooth, 0.01, 1.0)
end

_G.FriendColor  = Color3.fromRGB(0, 255, 100)
_G.EnemyColor   = Color3.fromRGB(255, 50, 50)
_G.UseTeamColor = true

local function getColor(p)
    if _G.UseTeamColor then return p.TeamColor.Color end
    return (LocalPlayer.TeamColor == p.TeamColor) and _G.FriendColor or _G.EnemyColor
end

local function hpColor(pct)
    if pct > 0.5 then return Color3.fromRGB(math.floor(255*(1-pct)*2),255,0)
    else return Color3.fromRGB(255,math.floor(255*pct*2),0) end
end

local function makeLine(thick,col)
    local l=Drawing.new("Line"); l.Visible=false; l.Thickness=thick; l.Color=col; l.ZIndex=5; return l
end
local function makeCircle(r,thick,col)
    local c=Drawing.new("Circle"); c.Visible=false; c.Filled=false; c.Thickness=thick
    c.Radius=r; c.Color=col; c.ZIndex=5; return c
end
local function makeText(sz,col,center)
    local t=Drawing.new("Text"); t.Visible=false; t.Size=sz; t.Color=col
    t.Outline=true; t.Center=(center~=false); t.ZIndex=6; return t
end

local function isVisible(pos)
    if not FLAGS.WallCheck then return true end
    local char=LocalPlayer.Character; if not char then return true end
    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return true end
    local rp=RaycastParams.new()
    rp.FilterDescendantsInstances={char}; rp.FilterType=Enum.RaycastFilterType.Exclude
    local res=workspace:Raycast(hrp.Position,pos-hrp.Position,rp)
    if res then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then
                if res.Instance:IsDescendantOf(p.Character) then return true end
            end
        end
        return false
    end
    return true
end

local function isEnemy(p)
    if not FLAGS.TeamCheck then return true end
    return LocalPlayer.TeamColor~=p.TeamColor
end

